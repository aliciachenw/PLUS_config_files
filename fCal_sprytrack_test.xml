<PlusConfiguration version="2.7">
  <DataCollection StartupDelaySec="1.0">
    <DeviceSet
      Name="PlusServer: Atracsys"
      Description="Broadcasting tracking data from Atracsys spryTrack180, fusionTrack250 or fusionTrack500 through OpenIGTLink."
    />
    <Device
      Id="TrackerDevice"
      Type="AtracsysTracker"
      MaxMissingFiducials="2"
      MaxMeanRegistrationErrorMm="5.0"
      ActiveMarkerPairingTimeSec="15"
      ToolReferenceFrame="Tracker" >
      <DataSources>
        <DataSource Type="Tool" Id="Stylus" TrackingType="PASSIVE" GeometryFile="AtracsysTools/cross_probe.ini" />
      </DataSources>
      <OutputChannels>
        <OutputChannel Id="TrackerStream">
        <DataSource Type="Tool" Id="Stylus" />
        </OutputChannel>
      </OutputChannels>
    </Device>
  </DataCollection>
  
</PlusConfiguration>